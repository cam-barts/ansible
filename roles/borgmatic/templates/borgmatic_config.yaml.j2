# {{ ansible_managed }}
# borgmatic config for {{ borgmatic_repo_label }} → gastown push. Rendered by
# Ansible role `borgmatic`. Edit the host_vars for this host (or the role
# defaults), not this file directly: the next playbook run will clobber hand
# edits.
#
# Hand-debugging entry points:
#   sudo {{ borgmatic_run_script_path }}
#   sudo borgmatic --config {{ borgmatic_config_path }} create --dry-run -v 1

source_directories:
{% for d in borgmatic_source_directories %}
    - {{ d | tojson }}
{% endfor %}

repositories:
    - path: {{ borgmatic_repo_url | tojson }}
      label: {{ borgmatic_repo_label }}

# Path to borg on the remote (gastown) side. gastown's nux shell doesn't have
# /usr/local/bin on its non-interactive PATH so borg needs an explicit path.
remote_path: {{ borgmatic_remote_path | tojson }}

{% if borgmatic_ssh_command | default('', true) %}
# No -i here on purpose: the identity is pinned in /root/.ssh/config. BatchMode
# is what stops a rejected key from turning into a password prompt that hangs
# the run forever. See this host's host_vars.
ssh_command: {{ borgmatic_ssh_command | tojson }}

{% endif %}
# Encryption passphrase. Read from {{ borgmatic_passphrase_file }} at run time
# so it lands neither in this config nor in version control. That file is
# populated by Ansible from the ansible-vault var
# `{{ borgmatic_passphrase_var }}`.
encryption_passcommand: {{ borgmatic_encryption_passcommand | tojson }}

exclude_patterns:
{% for p in borgmatic_excludes %}
    - {{ p | tojson }}
{% endfor %}

exclude_caches: true
exclude_if_present:
    - .nobackup
    - CACHEDIR.TAG
one_file_system: false

compression: {{ borgmatic_compression }}

{% if borgmatic_checkpoint_interval | default('', true) %}
# Carried forward from the pre-Ansible config (stock default is 1800).
checkpoint_interval: {{ borgmatic_checkpoint_interval }}

{% endif %}
# Retention.
keep_daily: {{ borgmatic_keep_daily }}
keep_weekly: {{ borgmatic_keep_weekly }}
keep_monthly: {{ borgmatic_keep_monthly }}
keep_yearly: {{ borgmatic_keep_yearly }}

# Consistency checks. data = block-level integrity, extract = full-restore
# rehearsal. Same cadence on every borgmatic host.
checks:
{% for c in borgmatic_consistency_checks %}
    - name: {{ c.name }}
      frequency: {{ c.frequency }}
{% endfor %}

{% if borgmatic_databases | length > 0 %}
# DB dumps. Borgmatic's native postgresql_databases/mariadb_databases hooks
# would need pg_dumpall / mariadb-dump installed on the host and direct
# network access into the containers. The DBs run inside docker without those
# binaries on the host, so dumps are staged by the before-create command hook
# via `docker exec` into the running containers, then the staging dir
# ({{ borgmatic_dump_dir }}) is captured as a regular source directory. The
# after-create hook wipes the staging dir.
#
# Migrated 2026-08-12 from the deprecated before_backup/after_backup/on_error
# options. These three hooks are exactly what borgmatic's own normalize.py
# rewrites those deprecated options into, so behaviour is unchanged.
{% endif %}
# The trailing "|| true" is the load-bearing bit: a hook stumble must never
# abort the filesystem backup. borgmatic aborts the run if ANY before-hook
# command exits non-zero, including 126/127 if a script goes missing or loses
# its exec bit, so the guarantee lives here at the config level rather than
# depending on every script staying well-behaved forever. A failed dump still
# alerts (ntfy) and leaves a DUMP-FAILED marker; see borgmatic-dump-dbs.sh.
commands:
    - before: action
      when: [create]
      run:
{% if borgmatic_databases | length > 0 %}
          - "/usr/local/bin/borgmatic-dump-dbs.sh || true"
{% endif %}
          - "{{ borgmatic_export_script_path }} || true"

{% if borgmatic_databases | length > 0 %}
    - after: action
      when: [create]
      run:
          - /usr/local/bin/borgmatic-cleanup-dumps.sh

{% endif %}
    # ntfy on error. Named priorities, single {{ borgmatic_ntfy_topic }} topic,
    # per-host titles so the streams stay visually separable.
    # The "when:" list mirrors what on_error normalized to, without it the
    # hook would also fire for interactive list/info/mount failures and page
    # Cam at {{ borgmatic_ntfy_priority_fail }} priority for a typo'd archive name.
    - after: error
      when: [create, prune, compact, check]
      run:
          - "{{ borgmatic_ntfy_bin }} publish -t 'Borg Backup FAILED ({{ borgmatic_repo_label | capitalize }})' -p {{ borgmatic_ntfy_priority_fail }} --tags=backup,{{ borgmatic_repo_label }},warning {{ borgmatic_ntfy_topic }} '{{ borgmatic_repo_label }}→gastown borg push failed, see {{ borgmatic_log_path }}'"
