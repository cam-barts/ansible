#!/bin/sh
# rsnapshot-run.sh: invoked by synoschedtask (hourly/daily/weekly/monthly).
# Runs rsnapshot with the live config path and sends notifications via ntfy
# with priority by outcome.
#
# Replaces the legacy "cmd1 && cmd2 || cmd3" chain whose || branch fired the
# "Completed" message on FAILURE: that bug hid the April 13 break for a
# month. Logic is now explicit if/elif/else so success / warnings / failure
# are routed separately and you only get paged for real failures.

set -u

interval="${1:-hourly}"

config="{{ rsnapshot_config_path }}"
rsnapshot="{{ rsnapshot_bin }}"
ntfy="{{ rsnapshot_ntfy_bin }}"
topic="{{ rsnapshot_ntfy_topic }}"

# Capture wrapper stdout/stderr to a fixed file on /volume1. Overwrite-on-
# start (single `>`) so the file stays bounded to a single run's worth of
# output: the 2026-05-12 incident was a 343M unbounded growth on / when
# this lived under nux's home on /dev/md0.
exec >"{{ rsnapshot_wrapper_out_path }}" 2>&1

# Serialise the intervals against each other.
#
# rsnapshot uses ONE lockfile for all four intervals ({{ rsnapshot_lockfile }}),
# and on contention it does not wait: add_lockfile() prints "Lockfile ... exists
# and so does its process, can not continue" and exits 1 before touching a
# single source. Exit 1 is rsnapshot's generic fatal code, so it lands in the
# else branch below and pages as FAILED, which is exactly the false alarm the
# April 13 rewrite above was meant to stop.
#
# That collision is structural, not occasional. Measured 2026-08-18: hourly
# fires at :00 every hour and took 23 to 50 minutes across twelve consecutive
# runs, while daily fires at a fixed :20. The shortest hourly run already
# outlasts daily's offset, so daily loses the race every day. Observed
# 00:00:02 hourly started, 00:20:04 daily started, 00:20:06 daily FAILED,
# 00:34:28 hourly finished.
#
# WAIT, do not skip. The sibling borgmatic-run.sh uses `flock -n` and exits,
# which is right there because borgmatic has a single daily schedule and a
# skipped run is just a duplicate. Here the intervals are retention tiers: a
# skipped daily means daily.0 never rotates and that day's tier is lost
# silently. Waiting costs a delayed snapshot; skipping costs a missing one.
# flock queues, so daily simply starts when hourly finishes and the next
# hourly queues behind it in turn.
exec 9>"{{ rsnapshot_wrapper_lockfile }}"
if ! flock -w {{ rsnapshot_lock_wait_seconds }} 9; then
    # Could not get in within the window. Not a backup failure, so not a page,
    # but a tier really did not run: if this shows up repeatedly, hourly has
    # grown past the point where the schedule fits and the DSM times need
    # spreading out.
    "$ntfy" publish \
        -t "rsnapshot $interval skipped" \
        -p {{ rsnapshot_ntfy_priority_warn }} \
        --tags=backup,hourglass \
        "$topic" \
        "rsnapshot $interval waited {{ rsnapshot_lock_wait_seconds }}s for another interval to finish and gave up; no snapshot taken for this tier" >/dev/null 2>&1 || true
    exit 0
fi

# Bound the rsnapshot log (root-owned, separate from the wrapper's own stdout
# capture above). Nothing on gastown rotates it: it is absent from
# /etc/logrotate.conf, all 60 files under /etc/logrotate.d/, and
# /usr/local/etc/logrotate.d/, and /usr/syno/etc/logrotate* does not exist at
# all. It reached 1.1G unrotated (checked 2026-08-25). A logrotate drop-in
# would need root to deploy and this role deliberately avoids `become`, so
# the wrapper trims it here instead, since it already runs as root under
# synoschedtask.
#
# `cat > "$log"` truncates in place and keeps the inode: rsnapshot opens the
# log O_APPEND, so `mv` or `rm` here would orphan that fd and the space it
# holds open would not free until the running rsnapshot process exits.
log="{{ rsnapshot_log_path }}"
log_size=$(stat -c %s "$log" 2>/dev/null || echo 0)
if [ "$log_size" -gt {{ rsnapshot_log_max_bytes }} ]; then
    tmp=$(mktemp) && tail -c {{ rsnapshot_log_tail_bytes }} "$log" > "$tmp" && cat "$tmp" > "$log" && rm -f "$tmp"
fi

# Low-disk alert on /volume1. gastown is not in inventory's node_exporter
# group, so it exports no Prometheus metrics and no Grafana alert can fire
# for it: ntfy is the only signal this tier has. /volume1 silently filled to
# 96% on 2026-08-25 and broke both backup tiers before anyone noticed. `df
# -P` in 1K blocks is portable across the DSM busybox/coreutils mix.
#
# Warn and continue rather than abort: a degraded backup still beats no
# backup. This can only warn while rsnapshot itself still runs, so it cannot
# catch a scheduler that stopped firing entirely.
# df is pointed at the snapshot root rather than a hardcoded /volume1 so the
# alert follows the data if the root ever moves; df reports the filesystem
# containing the path either way. GB in the message because this lands on a
# phone, where a raw KB figure is unreadable at a glance.
disk_free_kb=$(df -P {{ rsnapshot_snapshot_root }} 2>/dev/null | awk 'NR==2 {print $4}')
if [ -n "${disk_free_kb:-}" ] && [ "$disk_free_kb" -lt {{ rsnapshot_disk_free_floor_kb }} ]; then
    disk_free_gb=$((disk_free_kb / 1048576))
    "$ntfy" publish \
        -t "rsnapshot $interval low disk" \
        -p {{ rsnapshot_ntfy_priority_fail }} \
        --tags=backup,warning \
        "$topic" \
        "{{ rsnapshot_snapshot_root }} has ${disk_free_gb}G free on {{ inventory_hostname }}, below the {{ (rsnapshot_disk_free_floor_kb / 1048576) | int }}G floor; backup continuing anyway but the volume needs attention" >/dev/null 2>&1 || true
fi

"$ntfy" publish \
    -t "rsnapshot $interval started" \
    -p {{ rsnapshot_ntfy_priority_start }} \
    --tags=backup,floppy_disk \
    "$topic" \
    "rsnapshot $interval started on {{ inventory_hostname }}" >/dev/null 2>&1 || true

"$rsnapshot" -c "$config" "$interval"
rc=$?

if [ "$rc" -eq 0 ]; then
    "$ntfy" publish \
        -t "rsnapshot $interval ok" \
        -p {{ rsnapshot_ntfy_priority_ok }} \
        --tags=backup,white_check_mark \
        "$topic" \
        "rsnapshot $interval completed cleanly on {{ inventory_hostname }}" >/dev/null 2>&1 || true
    exit 0
elif [ "$rc" -eq 2 ]; then
    # rsnapshot exit 2 = "completed with warnings" (typically rsync partial
    # transfers from permission-denied on locked DB / cert files). The
    # backup itself landed; we want awareness, not a page. Exit 0 so
    # synoschedtask records it as success.
    "$ntfy" publish \
        -t "rsnapshot $interval completed with warnings" \
        -p {{ rsnapshot_ntfy_priority_warn }} \
        --tags=backup,information_source \
        "$topic" \
        "rsnapshot $interval completed but some files weren't transferred (perms, locked DBs, etc.), see {{ rsnapshot_log_path }}" >/dev/null 2>&1 || true
    exit 0
else
    "$ntfy" publish \
        -t "rsnapshot $interval FAILED" \
        -p {{ rsnapshot_ntfy_priority_fail }} \
        --tags=backup,warning \
        "$topic" \
        "rsnapshot $interval exited $rc on {{ inventory_hostname }}, see {{ rsnapshot_log_path }}" >/dev/null 2>&1 || true
    exit "$rc"
fi
