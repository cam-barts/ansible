#################################################
# rsnapshot.conf: live config for gastown.     #
#                                                #
# History note: SynoCommunity rsnapshot 1.5.1-5  #
# postinst (Apr 13 2026) ran $RM ${PKGDEST}/var, #
# wiping /var/packages/rsnapshot/target/var/ and #
# the default config path the binary compiles    #
# to. Config now lives here, outside the package #
# directory, so the next upgrade cannot kill it. #
#                                                #
# Tabs (not spaces) between fields are mandatory.#
#################################################

#######################
# CONFIG FILE VERSION #
#######################

config_version	1.2

###########################
# SNAPSHOT ROOT DIRECTORY #
###########################

# Existing tree on /volume1/pi_rsnapshots/: preserved as-is. Historical
# directories (hourly.0 frozen at 2026-04-13) will age out of rotation as
# new hourlies push them off the queue.
snapshot_root	{{ rsnapshot_snapshot_root }}

#################################
# EXTERNAL PROGRAM DEPENDENCIES #
#################################

cmd_rm		/bin/rm
cmd_rsync	/bin/rsync
# Force rsync's --link-dest fallback for rotation. SynoCommunity rsnapshot's
# native_cp_al is silently broken on gastown: without this the rotation
# step byte-copies every file instead of hardlinking, blowing up the
# snapshot tree. With link_dest=1, rsnapshot passes --link-dest=../$prev/
# to rsync and dedup is restored.
link_dest	{{ rsnapshot_link_dest }}
cmd_ssh		/usr/bin/ssh
cmd_logger	/usr/bin/logger
cmd_du		/bin/du

#########################
#     BACKUP INTERVALS  #
#########################

# 24 hourly + 7 daily + 4 weekly + 12 monthly.
# Matches the existing rotation depth on disk.
retain	hourly	{{ rsnapshot_retain_hourly }}
retain	daily	{{ rsnapshot_retain_daily }}
retain	weekly	{{ rsnapshot_retain_weekly }}
retain	monthly	{{ rsnapshot_retain_monthly }}

############################################
#              GLOBAL OPTIONS              #
############################################

verbose		{{ rsnapshot_verbose }}
loglevel	{{ rsnapshot_loglevel }}
logfile		{{ rsnapshot_log_path }}
lockfile	{{ rsnapshot_lockfile }}
exclude_file	{{ rsnapshot_excludes_path }}

# SSH key for source-side pulls. Same key trusts gastown→warrig,
# gastown→nux@citadel, and gastown→pirate@<pi> for all three Pis.
ssh_args	{{ rsnapshot_ssh_args }}

###############################
### BACKUP POINTS / SCRIPTS ###
###############################

{% set primary = rsnapshot_sources[0] %}
{% set secondary = rsnapshot_sources[1] %}
{% set pis = rsnapshot_sources[2:] %}
# {{ primary.name }}: {{ primary.note }}
{% if primary.disabled | default(false) %}#{% endif %}backup	{{ primary.ssh_target }}:{{ primary.source_path }}	{{ primary.name }}/

# {{ secondary.name }}: {{ secondary.note }}
{% if secondary.disabled | default(false) %}#{% endif %}backup	{{ secondary.ssh_target }}:{{ secondary.source_path }}	{{ secondary.name }}/

# Raspberry Pis: user is pirate, not nux (no /home/nux exists on the Pis).
# Matches the historical pi_rsnapshots tree shape (wellerman/home/pirate/...).
{% for src in pis %}
{% if src.disabled | default(false) %}#{% endif %}backup	{{ src.ssh_target }}:{{ src.source_path }}	{{ src.name }}/
{% endfor %}
