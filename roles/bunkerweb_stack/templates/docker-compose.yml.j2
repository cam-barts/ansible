x-bw-env: &bw-env
  # We use an anchor to avoid repeating the same settings for both services
  API_WHITELIST_IPS: "{{ bunkerweb_whitelist_ips }}" # Make sure to set the correct IP range so the scheduler can send the configuration to the instance
  API_WHITELIST_IP: "{{ bunkerweb_whitelist_ips }}" # Make sure to set the correct IP range so the scheduler can send the configuration to the instance
  WHITELIST_IP: "{{ bunkerweb_whitelist_ips }}" # Make sure to set the correct IP range so the scheduler can send the configuration to the instance
  DATABASE_URI: "mariadb+pymysql://bunkerweb:{{ bunkerweb_db_password }}@bw-db:3306/db" # Remember to set a stronger password for the database
  USE_ROBOTSTXT: "yes"
  USE_WHITELIST: "yes"
  API_RATE_LIMIT_ENABLED: "no"

services:
  bunkerweb:
    # This is the name that will be used to identify the instance in the Scheduler
    image: bunkerity/bunkerweb:1.6.9
    ports:
      - "80:8080/tcp"
      - "443:8443/tcp"
      - "443:8443/udp" # For QUIC / HTTP3 support
    environment:
      <<: *bw-env # We use the anchor to avoid repeating the same settings for all services
    extra_hosts:
      - "citadel.shadeking.cam.local:192.168.1.88"
    restart: "unless-stopped"
    networks:
      - bw-universe
      - bw-services

  bw-scheduler:
    image: bunkerity/bunkerweb-scheduler:1.6.9
    mem_limit: 512m
    environment:
      <<: *bw-env
      BUNKERWEB_INSTANCES: "bunkerweb" # Make sure to set the correct instance name
      MULTISITE: "yes"
      UI_HOST: "http://bw-ui:7000" # Change it if needed
      USE_REDIS: "yes"
      REDIS_HOST: "redis"
      SERVER_NAME: "bunkerweb.coder.cam"  # append to existing SERVER_NAME if present
    volumes:
      - bw-storage:/data # This is used to persist the cache and other data like the backups
    restart: "unless-stopped"
    networks:
      - bw-universe
      - bw-db

  bw-api:
    image: bunkerity/bunkerweb-api:1.6.9
    mem_limit: 512m
    restart: "unless-stopped"
    environment:
      <<: *bw-env
      API_USERNAME: "nux"
      API_PASSWORD: "{{ bunkerweb_api_password }}"
      # API_TOKEN: "admin-override-token" # optional
      # FORWARDED_ALLOW_IPS: ""
      API_WHITELIST_IPS: "{{ bunkerweb_whitelist_ips }}" # Make sure to set the correct IP range so the scheduler can send the configuration to the instance
      API_ROOT_PATH: "/api"
    networks:
      - bw-universe
      - bw-db

  bw-ui:
    image: bunkerity/bunkerweb-ui:1.6.9
    mem_limit: 512m
    environment:
      <<: *bw-env
    restart: "unless-stopped"
    networks:
      - bw-universe
      - bw-db

  bw-db:
    image: mariadb:11
    mem_limit: 2g
    # We set the max allowed packet size to avoid issues with large queries
    command: --max-allowed-packet=67108864
    environment:
      MYSQL_RANDOM_ROOT_PASSWORD: "yes"
      MYSQL_DATABASE: "db"
      MYSQL_USER: "bunkerweb"
      MYSQL_PASSWORD: "{{ bunkerweb_db_password }}" # Remember to set a stronger password for the database
    volumes:
      - bw-data:/var/lib/mysql
    restart: "unless-stopped"
    networks:
      - bw-db

  redis: # Redis service for the persistence of reports/bans/stats
    image: redis:7-alpine
    mem_limit: 512m
    command: >
      redis-server
      --maxmemory 256mb
      --maxmemory-policy allkeys-lru
      --save ""
      --appendonly no
    volumes:
      - redis-data:/data
    restart: "unless-stopped"
    networks:
      - bw-universe

  cloudflared:
    image: cloudflare/cloudflared:latest
    container_name: cloudflared
    user: "1000:1000"
    command: tunnel --no-autoupdate --config /etc/cloudflared/config.yml run
    volumes:
      - /home/nux/docker/cloudflared:/etc/cloudflared:ro
    restart: "unless-stopped"
    depends_on:
      - bunkerweb
    networks:
      - bw-services

volumes:
  bw-data:
  bw-storage:
  redis-data:

networks:
  bw-universe:
    name: bw-universe
    ipam:
      driver: default
      config:
        - subnet: 10.20.30.0/24 # Make sure to set the correct IP range so the scheduler can send the configuration to the instance
  bw-services:
    name: bw-services
  bw-db:
    name: bw-db
