services:
  silverbullet:
    # Pinned to stable 2.12.0 (2026-10-06), upgraded 2026-10-09 from the moving
    # `v2-runtime-api` tag (then at 2.10.0-255, built 2026-09-15). As of 2.11 the
    # default images bundle Chromium, so the runtime API that `sb lua` needs is in
    # plain `:2.12.0`; the `-runtime-api` suffix is history (`:2.12.0-slim` is the
    # Chromium-less one). Pinned on purpose: a moving tag already broke the runtime
    # once (2.9.0-45, headless CDP `enable runtime` timeout -> `sb lua` 503s).
    # Rollback: ghcr.io/silverbulletmd/silverbullet@sha256:a2fe4c456c6bacfc2053688a9321c379ae3cff72bbd229d386b9940fa31c6770
    #
    # (The old cold-/space/.chrome-data caveat moved: profiles now live under
    # /data, see the multi-space note below.)
    image: ghcr.io/silverbulletmd/silverbullet:2.12.0
    restart: unless-stopped
    shm_size: '512m'
    # entrypoint: ["/sbin/tini", "--", "/entrypoint-wrapper.sh"]
    #
    # MULTI-SPACE MODE since 2026-10-11. Accounts live in data/users.json, space
    # config in data/spaces.json, server config in data/server.json; all three are
    # managed through the Dashboard at /.dashboard (404 in the old legacy mode, so
    # that endpoint is the one-line check for which mode you are in).
    #
    # SB_USER and SB_AUTH_TOKEN are GONE ON PURPOSE, not forgotten:
    # boot.rs::detect() makes either one a REFUSE-TO-BOOT error once spaces.json
    # exists ("Accounts now live in users.json, unset SB_USER"). Per-account API
    # tokens from the Dashboard replace them. SB_REVISIONS is also gone; revisions
    # are per-space config now (spaces.json `revisions: "managed"`).
    #
    # Both mounts are deliberate. The entrypoint prefers /data when both are
    # present and logs "using /data, ignoring /space". /space stays mounted
    # because spaces.json points the space at the ABSOLUTE path /space, which
    # upstream calls "a deliberate external mount" (setup.rs). That is what keeps
    # every sidecar's ./space mount and every host script's path unchanged: the
    # 1.5G of markdown never moved.
    #
    # Chrome profiles now live at data/.chrome-data (one per user+space), NOT in
    # the space any more. First boot on a cold profile reports the runtime as
    # "starting" and /.runtime/lua 503s while it indexes the whole space; on this
    # space that took ~7 min. Expected exactly once. force-reindex.sh knows the
    # new path.
    volumes:
      - ./data:/data
      - ./space:/space
      # - ./entrypoint-wrapper.sh:/entrypoint-wrapper.sh:ro
    ports:
      - 6934:3000

  # ---------------------------------------------------------------------
  # Fast Search backend — consolidated into this stack (was its own compose
  # under ~/git/home/silverbullet-fast-search). All three services now share
  # this project's default network, so the sidecar reaches Meilisearch by
  # service name and the sidecar reads the SB space straight off disk instead
  # of pulling over HTTP. No more static IP / external-network bridge.
  # ---------------------------------------------------------------------
  meilisearch:
    image: getmeili/meilisearch:v1.21
    restart: unless-stopped
    # Added 2026-10-12, resized 2026-10-13. The original 2g was sized from
    # LOGICAL data size (~86 MB of document store plus ~143 MB of float32
    # vectors) and that was the wrong basis: it counts neither Meilisearch's own
    # heap nor the LMDB page-cache working set. Measured under a full reindex,
    # the 2g cap was pathological — cgroup `memory.current` pinned at 99.99% of
    # the limit, `memory.events max` 1,571,426 hard-limit hits, `pgsteal` 97.4M
    # pages, `pgmajfault` 198,450, and cgroup `io.pressure full avg10` 20.47,
    # i.e. fully IO-stalled a fifth of the time. Push throughput collapsed from
    # ~22 docs/s to ~2 docs/s with Meilisearch at 11% CPU and the embedder
    # answering in 58 ms, so neither CPU nor Ollama was the constraint. It had
    # also pushed 483 MiB of its own heap into host swap, making the limit a
    # CONTRIBUTOR to the full-swap symptom it was partly meant to address.
    #
    # Resized against the real working set: ~1.8 GiB heap (1.28 GiB resident
    # plus the 483 MiB that had been swapped out) and a 3.6 GiB LMDB that wants
    # to be page-cacheable, with a reindex transiently holding live + staging
    # (~7 GiB on disk). 10g covers that with room for index growth and is still
    # a real bound; the host has 31 GiB available. memory-swap equal to memory
    # (no container swap) is deliberate: a search engine paging its heap to a
    # full host swap device is the behaviour being removed, and file pages are
    # reclaimable without an OOM kill, so only the ~1.8 GiB of anon has to fit.
    #
    # CPU deliberately left at 2.0: measured at 11% during the rebuild, so it
    # is not the binding constraint and there is nothing to justify changing.
    # Compose v2 honours deploy.resources.limits outside swarm.
    deploy:
      resources:
        limits:
          cpus: "2.0"
          memory: 10g
        reservations:
          memory: 512m
    # memory+swap total. Equal to the memory limit means no container swap, per
    # the reasoning above. Lives here rather than under deploy: because
    # deploy.resources has no swap key; compose maps this to HostConfig.MemorySwap.
    memswap_limit: 10g
    environment:
      - MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
      - MEILI_ENV=production
      - MEILI_NO_ANALYTICS=true
      - MEILI_HTTP_ADDR=0.0.0.0:7700
    volumes:
      - ./meili_data:/meili_data
    # 7701 published on all host interfaces so the BunkerWeb reverse proxy on
    # Citadel can reach it as warrig:7701 and serve https://search.bullet.coder.cam.
    # Loopback (127.0.0.1:7701) still works for local runbook/curl. Every route
    # except /health is API-key gated (MEILI_ENV=production); only the
    # search-only key is used client-side, the master key stays on the internal
    # docker network (sidecar -> meilisearch:7700).
    ports:
      - "7701:7700"
    # Embedder calls Ollama on the host (nomic-embed-text). host.docker.internal
    # resolves to the docker0 gateway; Ollama listens on 11434 on the host.
    extra_hosts:
      - "host.docker.internal:host-gateway"

  sidecar:
    image: ghcr.io/astral-sh/uv:python3.12-bookworm-slim
    restart: unless-stopped
    depends_on:
      - silverbullet
      - meilisearch
    environment:
      - MEILI_URL=http://meilisearch:7700
      - MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
      # Filesystem mode: read pages straight off the bind-mounted space/ dir.
      # The poll loop becomes a filesystem mtime scan (SIDECAR_POLL_INTERVAL).
      - SIDECAR_SPACE_DIR=/space
      - SIDECAR_POLL_INTERVAL=15
      - SIDECAR_INDEX_NAME=silverbullet
      - SIDECAR_EXCLUDE_PREFIXES=_attachments/,Library/Std/,.chrome-data/
      # Secondary corpus: Cam's blog (Quartz markdown), indexed by reindex-blog.
      - SIDECAR_BLOG_DIR=/blog
      - SIDECAR_BLOG_INDEX_NAME=blog
      # HTTP fallback creds, only used if SIDECAR_SPACE_DIR is ever unset. Bearer
      # token only now: SB_USER is gone with single-space mode.
      - SB_URL=${SB_URL}
      - SB_AUTH_TOKEN=${SB_AUTH_TOKEN}
    volumes:
      # The SB space, read-only — this is what enables filesystem mode.
      - ./space:/space:ro
      # Sidecar code now lives in this directory (copied out of git/home).
      - ./sidecar:/sidecar:ro
      # Blog content tree (separate repo, left in place).
      - /home/nux/git_local/cam-barts.github.io/content:/blog:ro
    working_dir: /sidecar
    # uv run handles PEP 723 inline metadata; deps install on first run.
    command: ["uv", "run", "--no-project", "/sidecar/indexer.py", "serve"]
    extra_hosts:
      - "host.docker.internal:host-gateway"

  # ---------------------------------------------------------------------
  # PDF report renderer. Unlike the other services this one has a Dockerfile:
  # it bakes in the whole pandoc + lualatex + Eisvogel + fonts toolchain so the
  # host can drop TeX Live. SilverBullet triggers it via net.proxyFetch to
  # http://pdf-sidecar:8000/render; it reads the bind-mounted space, renders a
  # branded PDF, and writes <Page>.pdf next to the source (RW mount). See
  # ./pdf-sidecar/ and space/Library/Personal/PDF Report.md.
  # ---------------------------------------------------------------------
  pdf-sidecar:
    build: ./pdf-sidecar
    restart: unless-stopped
    # Runs as nux so the <Page>.pdf it writes into the space is owned by the same
    # uid SilverBullet runs as (1000). Before 2026-10-11 this container ran as
    # root, so every generated PDF landed root-owned inside a uid-1000 space:
    # readable, but not writable or re-renderable by SB itself.
    #
    # No passwd entry exists for 1000 in the image, so HOME would be unset and
    # lualatex's luaotfload font cache would have nowhere to go. HOME=/tmp fixes
    # that; the build itself already happens in a tempfile.TemporaryDirectory().
    user: "1000:1000"
    depends_on:
      - silverbullet
    environment:
      - HOME=/tmp
      - SPACE_DIR=/space
      # Vendored template (pdf-sidecar/eisvogel.latex), not the bare name resolved
      # from the floating pandoc/extra:latest base image. See its header comment.
      - EISVOGEL_TEMPLATE=/app/eisvogel.latex
      - DEFAULT_THEME=observatory
      # Cap that drops pathological full-page scroll-captures. Legit before/after
      # comparison screenshots run ~2500-6300px tall, so 8000 keeps them while still
      # catching runaway captures.
      - MAX_IMAGE_HEIGHT_PX=8000
      - PORT=8000
      # /render requires Authorization: Bearer <this> (endpoint is public via BunkerWeb
      # at https://pdf.coder.cam). Token lives in .env.
      - RENDER_TOKEN=${RENDER_TOKEN}
    volumes:
      # RW: the renderer writes the generated PDF back into the space.
      - ./space:/space
      # Code mounted for quick iteration; the image also COPYs it in.
      - ./pdf-sidecar:/app:ro
      # host zone file (Alpine lacks tzdata); with TZ unset, musl reads this so the
      # default report date ("today") matches Cam's local day, not UTC
      - /etc/localtime:/etc/localtime:ro
    # Published for net.proxyFetch fallback + local curl testing; in-network the
    # SB container reaches it as pdf-sidecar:8000 without this.
    ports:
      - "8391:8000"

  # ---------------------------------------------------------------------
  # Fast capture. A tiny PWA + write endpoint whose entire point is that it
  # NEVER loads the space — SB's own client parses ~1MB of JS and indexes
  # 24MB of markdown before it accepts a keystroke, which is unusable on a
  # phone and gets worse as the space grows. This opens to a textarea in
  # milliseconds, queues in IndexedDB, and PUTs each capture out of band as a
  # NEW dated page (Inbox/<date>/<time>-<id>.md, SB's own Quick Note layout).
  #
  # Never edits an existing page: that's what keeps it clear of the `sb sync`
  # conflict class. The client-supplied id makes the path deterministic, so a
  # retried flush rewrites identical bytes — idempotent with no dedup store.
  #
  # Reaches SB in-network as silverbullet:3000, so the SB token never leaves
  # the docker network and captures still land if BunkerWeb/Cloudflare are
  # down. Public at https://capture.coder.cam behind USE_AUTH_BASIC.
  # Zero-Dockerfile house pattern: stock uv image + PEP 723 header in main.py.
  # ---------------------------------------------------------------------
  capture:
    image: ghcr.io/astral-sh/uv:python3.12-bookworm-slim
    restart: unless-stopped
    depends_on:
      - silverbullet
    environment:
      - SB_URL=http://silverbullet:3000
      - SB_AUTH_TOKEN=${SB_AUTH_TOKEN}
      - CAPTURE_FOLDER=Inbox
    volumes:
      - ./capture:/app:ro
      # Without this the container is UTC, so anything captured after 8pm EDT
      # would file itself into tomorrow's dated folder. Same reason pdf-sidecar
      # mounts it.
      - /etc/localtime:/etc/localtime:ro
    working_dir: /app
    command: ["uv", "run", "--no-project", "/app/main.py"]
    ports:
      - "8392:8000"

  # ---------------------------------------------------------------------
  # Podcast transcript search. Indexes MinusPod transcripts into the same
  # Meilisearch, one document per ~45s chunk so a hit deep-links to a
  # timestamp rather than to a 90-minute file. Shares the `nomic` embedder
  # with the silverbullet and blog indexes, so semantic and hybrid search
  # behave identically across all three.
  #
  # Hourly, not the 15s poll the space indexer uses: transcripts only change
  # when an episode finishes processing, and Meilisearch re-embeds only the
  # documents whose content actually changed.
  # ---------------------------------------------------------------------
  podcast-indexer:
    image: ghcr.io/astral-sh/uv:python3.12-bookworm-slim
    restart: unless-stopped
    depends_on:
      - meilisearch
    environment:
      - MEILI_URL=http://meilisearch:7700
      - MEILI_MASTER_KEY=${MEILI_MASTER_KEY}
      - PODCAST_INDEX=podcasts
      - PODCAST_INDEX_INTERVAL=3600
      - MINUSPOD_DB=/minuspod-data/podcast.db
      - PODCAST_VAULT=/vault/transcripts.db
      # Public origin, not localhost:8077: the indexed `url` is what a SearXNG
      # result links to, so it has to resolve from Cam's phone, not just this
      # host. The feed key goes with it because MinusPod's feedAuth gates
      # /episodes/ and a bare enclosure URL 401s (and repeated 401s feed
      # BunkerWeb's BADBEHAVIOR ban counter).
      - MINUSPOD_BASE=https://minuspod.coder.cam
      - MINUSPOD_FEED_KEY=${MINUSPOD_FEED_KEY}
      - OLLAMA_EMBED_URL=http://host.docker.internal:11434/api/embeddings
      - UV_CACHE_DIR=/tmp/uv-cache
      # stdout is a pipe here, so Python block-buffers it. Only `push` passes
      # flush=True, so the pass's own status lines ("done", the prune result)
      # sat in the buffer until the NEXT pass's pushes shoved them out an hour
      # later. That makes the log read as if a pass hung. Cheaper than putting
      # flush=True on every print.
      - PYTHONUNBUFFERED=1
    volumes:
      - ./sidecar:/sidecar:ro
      - /home/nux/docker_services/minuspod/data:/minuspod-data:ro
      # The only writable mount this container gets, and deliberately NOT
      # inside minuspod/data: the transcript vault has to outlive the DB it is
      # copied from, including a restore from a podcast-pre-upgrade-*.db.
      - /home/nux/docker_services/minuspod/vault:/vault
    working_dir: /sidecar
    command: ["uv", "run", "--no-project", "--with", "httpx",
              "/sidecar/podcast_indexer.py", "serve"]
    extra_hosts:
      - "host.docker.internal:host-gateway"
    logging:
      driver: json-file
      options:
        max-size: "20m"
        max-file: "3"
