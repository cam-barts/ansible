# Loaded by docker-compose at `up` time. Consolidated from the old
# ~/git/home/silverbullet-fast-search/.env when Fast Search was folded into
# this stack. The SB_* vars are an HTTP-mode fallback for the sidecar; the
# default is filesystem mode (SIDECAR_SPACE_DIR=/space), which ignores them.
MEILI_MASTER_KEY={{ silverbullet_meili_master_key }}
SB_URL=http://host.docker.internal:6934
SB_AUTH_TOKEN={{ silverbullet_sb_auth_token }}
SB_USER=nux

# pdf-sidecar /render bearer token (endpoint exposed at https://pdf.coder.cam)
RENDER_TOKEN={{ silverbullet_render_token }}
