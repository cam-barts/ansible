---
version: "2.1"
services:
  pwndrop:
    image: lscr.io/linuxserver/pwndrop:latest
    container_name: pwndrop
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=America/New_York
      - SECRET_PATH={{ pwndrop_secret_path }} #optional
    volumes:
      - ./data:/config
    ports:
      - 6969:8080
    restart: unless-stopped
