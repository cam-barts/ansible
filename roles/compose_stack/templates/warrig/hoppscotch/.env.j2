#-----------------------Backend Config------------------------------#
# Prisma Config
DATABASE_URL={{ hoppscotch_database_url }} # or replace with your database URL

# Auth Tokens Config
JWT_SECRET={{ hoppscotch_jwt_secret }}
TOKEN_SALT_COMPLEXITY=10
MAGIC_LINK_TOKEN_VALIDITY=3
REFRESH_TOKEN_VALIDITY=604800000
ACCESS_TOKEN_VALIDITY=86400000
SESSION_SECRET={{ hoppscotch_session_secret }}

# Hoppscotch App Domain Config
REDIRECT_URL=https://hoppscotch.coder.cam
WHITELISTED_ORIGINS=https://hoppscotch-backend.coder.cam,https://hoppscotch.coder.cam,https://hoppscotch-admin.coder.cam,http://localhost:3170,http://localhost:3000,http://localhost:3100,app://localhost_3200,app://hoppscotch,https://hoppscotch-backend.coder.cam/graphql
VITE_ALLOWED_AUTH_PROVIDERS=GITHUB

# Github Auth Config
GITHUB_CLIENT_ID=5ada590886f881003e24
GITHUB_CLIENT_SECRET={{ hoppscotch_github_client_secret }}
GITHUB_CALLBACK_URL=https://hoppscotch-backend.coder.cam/v1/auth/github/callback
GITHUB_SCOPE=user:email

MAILER_SMTP_URL={{ hoppscotch_mailer_smtp_url }}
MAILER_ADDRESS_FROM=hoppscotch@coder.cam


# Rate Limit Config
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

#-----------------------Frontend Config------------------------------#

# # Base URLs
VITE_BASE_URL=https://hoppscotch.coder.cam
VITE_SHORTCODE_BASE_URL=https://hoppscotch.coder.cam
VITE_ADMIN_URL=https://hoppscotch-admin.coder.cam

# Backend URLs
VITE_BACKEND_GQL_URL=https://hoppscotch-backend.coder.cam/graphql
VITE_BACKEND_WS_URL=wss://hoppscotch-backend.coder.cam/graphql
VITE_BACKEND_API_URL=https://hoppscotch-backend.coder.cam/v1


# Terms Of Service And Privacy Policy Links (Optional)
VITE_APP_TOS_LINK=https://docs.hoppscotch.io/support/terms
VITE_APP_PRIVACY_POLICY_LINK=https://docs.hoppscotch.io/support/privacy

ENABLE_SUBPATH_BASED_ACCESS=false
# ENABLE_SUBPATH_BASED_ACCESS=true
# HOPP_AIO_ALTERNATE_PORT=3000

DATA_ENCRYPTION_KEY={{ hoppscotch_data_encryption_key }}
