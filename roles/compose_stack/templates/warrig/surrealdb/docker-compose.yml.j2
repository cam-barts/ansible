version: "3"
services:
  surrealdb:
    pull_policy: always
    user: "1000"
    # deploy:
    #   replicas: 3
    ports:
      - 1357:8000
    volumes:
      - ./mydata:/mydata
    image: surrealdb/surrealdb:v2
    command: start rocksdb:/mydata/mydatabase.db --log debug --user nux --password {{ surrealdb_password }} --temporary-directory /tmp
    # command: fix surrealkv://mydata/mydatabase.db
    restart: unless-stopped
