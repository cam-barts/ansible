version: "3"
services:
  surrealdb:
    pull_policy: always
    user: "1000"
    # deploy:
    #   replicas: 3
    ports:
      - 1357:8000
    volumes:
      - ./mydata:/mydata
    image: surrealdb/surrealdb:v2
    # Credentials via env, not argv: --password would be world-readable in
    # `ps` / /proc/*/cmdline / docker inspect on the host.
    environment:
      SURREAL_USER: nux
      SURREAL_PASS: "{{ surrealdb_password }}"
    command: start rocksdb:/mydata/mydatabase.db --log debug --temporary-directory /tmp
    # command: fix surrealkv://mydata/mydatabase.db
    restart: unless-stopped
