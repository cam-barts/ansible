#!/bin/sh
# {{ ansible_managed }}
# Exports installed-package lists so a future restore can rebuild the host's
# pacman state. Two files: explicit (pacman -Qe) and foreign/AUR (pacman -Qm).
# Citadel runs EndeavourOS (Arch-based), so pacman is authoritative.

set -u

pacman -Qe > /etc/pkg-explicit.list 2>/dev/null || true
pacman -Qm > /etc/pkg-foreign.list 2>/dev/null || true
exit 0
