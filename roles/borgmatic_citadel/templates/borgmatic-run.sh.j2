#!/bin/sh
# {{ ansible_managed }}
# borgmatic-run.sh — wrapper for the daily borgmatic invocation.
#
# Same explicit start/ok/fail pattern as rsnapshot-run.sh on gastown:
# success and failure go through different ntfy paths so a partial pipe
# never fires the "ok" message on a real failure.

set -u

# Serialise the whole run. Without this, a hand-run (`sudo borgmatic-run.sh` to
# debug last night) overlapping the {{ '%02d' % borgmatic_cron_hour }}:{{ '%02d' % borgmatic_cron_minute }} cron puts two borg processes against the
# same gastown repo; borg's own repo lock makes one of them fail rather than
# corrupt anything, but it fails as a *backup failure* ntfy — the wrong signal.
# Exit silently: the run already in progress owns the notifications.
exec 9>/var/lock/borgmatic-run.lock
flock -n 9 || {
    echo "borgmatic-run: another run holds the lock, skipping" >&2
    exit 0
}

ntfy="{{ borgmatic_ntfy_bin }}"
topic="{{ borgmatic_ntfy_topic }}"
config="{{ borgmatic_config_path }}"

"$ntfy" publish \
    -t "Borg Backup Started (Citadel)" \
    -p {{ borgmatic_ntfy_priority_start }} \
    --tags=backup,citadel,floppy_disk \
    "$topic" \
    "citadel→gastown borg push started" >/dev/null 2>&1 || true

if /usr/bin/borgmatic --config "$config"; then
    "$ntfy" publish \
        -t "Borg Backup OK (Citadel)" \
        -p {{ borgmatic_ntfy_priority_ok }} \
        --tags=backup,citadel,white_check_mark \
        "$topic" \
        "citadel→gastown borg push completed cleanly" >/dev/null 2>&1 || true
    exit 0
else
    rc=$?
    "$ntfy" publish \
        -t "Borg Backup FAILED (Citadel)" \
        -p {{ borgmatic_ntfy_priority_fail }} \
        --tags=backup,citadel,warning \
        "$topic" \
        "citadel→gastown borg push exited $rc — see {{ borgmatic_log_path }}" >/dev/null 2>&1 || true
    exit "$rc"
fi
