# Inventory for the borgmatic_citadel playbook. Combines the citadel push
# source and the gastown receive endpoint so a single ansible-playbook run
# can wire up the SSH key trust on both ends in one shot.
#
# Defined as a dedicated inventory rather than reused groups so that
# inventory/group_vars/citadel/vault.yml resolves cleanly (the existing
# `archlinux` group in inventory/node_exporter doesn't have a per-host vault
# attached, and the citadel-only group there would be overloaded).
#
# Group names are distinct from host names to avoid Ansible's "found both
# group and host with same name" warning. The group_vars file is keyed off
# the *host_vars* layout, not group_vars, so the group name is free to be
# anything readable.

[borgmatic_source]
citadel ansible_host=citadel.shadeking.cam.local

[borgmatic_source:vars]
ansible_user=nux

[borgmatic_target]
gastown ansible_host=gastown.shadeking.cam.local

[borgmatic_target:vars]
ansible_user=nux
ansible_ssh_private_key_file=~/.ssh/rsnapshot_key
# DSM 7.3 ships /usr/bin/python3 == 3.8 which is below ansible-core 2.18+
# minimum (3.9). Pin to the SynoCommunity Python 3.12 install.
ansible_python_interpreter=/usr/local/bin/python3.12
